{
  "name": "Maps By FUTA",
  "version": 1,
  "color": {
    "themes": [
      {
        "id": "default",
        "name": "Default"
      }
    ],
    "note": "The Maps By FUTA brand palette, curated from the app's v2 colours. Near-duplicates merged; legacy dark, landing and one-off screen colours removed.",
    "tokens": [
      {
        "name": "primary",
        "value": "#7c3aed",
        "usage": "THE brand violet. Primary buttons, active tabs, links, icon badges, brand accents. In code: --v2-primary."
      },
      {
        "name": "primary-hover",
        "value": "#6d28d9",
        "usage": "Hover/pressed state of primary fills, and violet text on primary-tint (6:1). In code: literal #6d28d9 on admin buttons."
      },
      {
        "name": "primary-tint",
        "value": "#ede9fe",
        "usage": "Pale violet fill: badges, pills, selected rows, icon circles. Also replaces #ece9f5. In code: literal #ede9fe; --v2-primary-badge-fill is this at 80%."
      },
      {
        "name": "white",
        "value": "#ffffff",
        "usage": "Text and icons on primary (5.7:1), primary-hover, secondary, ink and error; also card and modal fills on surface."
      },
      {
        "name": "ink",
        "value": "#0f172a",
        "usage": "Headings, the inverted button fill, strongest text. In code: --v2-neutral."
      },
      {
        "name": "text",
        "value": "#4a4455",
        "usage": "Body text on surface, white and surface-alt (8.9:1). In code: --v2-text."
      },
      {
        "name": "text-muted",
        "value": "#6b6478",
        "usage": "Secondary text, captions, placeholders on surface and white (5.4:1). Replaces #7b7487 (--v2-text-variant), which was under 4.5:1."
      },
      {
        "name": "surface",
        "value": "#f8f9ff",
        "usage": "Page and app background. Also replaces #f6f5fb."
      },
      {
        "name": "surface-alt",
        "value": "#f2f3ff",
        "usage": "Input fields, dropzones, HUD strips and banners on surface or white. Also replaces #eef1f8. In code: --v2-hud-upnext-bg."
      },
      {
        "name": "border",
        "value": "#e2e8f0",
        "usage": "Borders and dividers: cards, inputs, list rows, headers. In code: --v2-divider."
      },
      {
        "name": "scrim",
        "value": "rgba(15, 23, 42, 0.4)",
        "usage": "Backdrop behind modals and sheets (ink at 40%). In code: --v2-scrim."
      },
      {
        "name": "secondary",
        "value": "#0d9488",
        "usage": "Brand teal: secondary actions, switches, success states, destination pins. White on it is about 3.7:1 \u2014 bold 19px+ text only. In code: --v2-secondary."
      },
      {
        "name": "secondary-light",
        "value": "#6bd8cb",
        "usage": "Light teal accent fill: highlights, map route accents. A fill, not text on white (too light); ink reads on it. In code: --v2-nav-active-accent."
      },
      {
        "name": "secondary-tint",
        "value": "#e6f6f4",
        "usage": "Pale teal fill behind teal content (success banners, active chips). Teal text on it is only 3.4:1 \u2014 use ink or text on it."
      },
      {
        "name": "error",
        "value": "#ba1a1a",
        "usage": "Destructive buttons, error text and icons on white and error-tint (6.2:1). In code: --v2-error-text."
      },
      {
        "name": "error-tint",
        "value": "#fff8f7",
        "usage": "Pale red fill: hover on destructive outline buttons, error banners. In code: literal on the sign-out hover."
      },
      {
        "name": "star",
        "value": "#ffc857",
        "usage": "Rating star gold: filled star icons on place cards, reviews and the review form. An icon fill only, never text (about 1.5:1 on white). In code: --v2-star."
      }
    ]
  },
