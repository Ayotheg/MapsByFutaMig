# Copy to .env.local and fill in (ask a teammate). .env.local is gitignored.
# Read by src/lib/supabase.js.

VITE_SUPABASE_URL=https://vzjlarvtssybglwzfrhi.supabase.co
VITE_SUPABASE_ANON_KEY=

# Session replay (src/lib/sessionReplay.js). Project token from PostHog →
# Project settings; leave empty to disable. Host: us or eu.i.posthog.com.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Optional. ImageKit URL endpoint in front of Supabase Storage
# (e.g. https://ik.imagekit.io/<your_id>). Its origin must be
# https://vzjlarvtssybglwzfrhi.supabase.co/storage/v1/object/public/place-images
# Photos are resized and cached there, so Supabase egress stops growing.
# Leave empty to load photos straight from Supabase. VITE_IMAGE_PROXY_URL
# works too. If the account changes, update PHOTO_PROXY_PATH in public/sw.js.
IMAGE_PROXY_URL=

# Meet me / Race to a place: 'true' only after supabase/friends_realtime.sql
# is applied. Makes friends:* channels private (signed-in users only).
VITE_FRIENDS_PRIVATE_CHANNELS=
