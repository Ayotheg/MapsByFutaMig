# Copy this file to .env.local and fill in real values — .env.local is
# already gitignored by the Vite scaffold, so the real anon key never gets
# committed. See src/lib/supabase.js for how these are consumed.
#
# Flagged during Slice 10: both README.md and src/lib/supabase.js have
# referenced ".env.example" since Slice 2, but the file itself was never
# actually committed — created now since its contents were unambiguous.

VITE_SUPABASE_URL=https://ownzoiipqcblyjwfset.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional — tile-caching-implementation-guide.md, Step 5.
# Moves the "Light" basemap off tile.openstreetmap.org (OSM's free
# public/testing server — not meant for production traffic) onto
# MapTiler's tile API, which won't throttle real usage. Get a free key
# at https://www.maptiler.com/ (free tier covers this app's traffic).
# Leave both blank to keep using tile.openstreetmap.org as-is — nothing
# breaks either way, see MapShell.jsx's buildBaseLayer.
VITE_MAPTILER_KEY=
# Optional — defaults to "streets-v4" (basemaps.js) if unset.
VITE_MAPTILER_MAP_ID=
