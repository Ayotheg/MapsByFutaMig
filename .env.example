# Copy to .env.local and fill in (ask a teammate). .env.local is gitignored.
# Read by src/lib/supabase.js.

VITE_SUPABASE_URL=https://vzjlarvtssybglwzfrhi.supabase.co
VITE_SUPABASE_ANON_KEY=

# Session replay (src/lib/sessionReplay.js). Project token from PostHog →
# Project settings; leave empty to disable. Host: us or eu.i.posthog.com.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Optional. Serve place photos from Cloudflare R2 instead of Supabase Storage
# (see IMAGE_MIGRATION.md). Leave empty to keep using Supabase Storage.
VITE_IMAGE_CDN_URL=

# Optional, simplest option. ImageKit URL endpoint in front of Supabase
# Storage (e.g. https://ik.imagekit.io/<your_id>). Photos are resized and
# cached there, so Supabase egress stops growing. Leave empty to disable.
VITE_IMAGE_PROXY_URL=
