{
  "openapi": "3.0.3",
  "info": {
    "title": "Maps By FUTA Public API",
    "description": "Read-only access to FUTA campus places, categories, photos, and API-key usage. Successful data requests consume credits, except for the usage endpoint.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://mapsbyfuta.xyz/api",
      "description": "Maps By FUTA production API"
    }
  ],
  "tags": [
    {
      "name": "Places",
      "description": "Search and retrieve campus places."
    },
    {
      "name": "Categories",
      "description": "Place categories."
    },
    {
      "name": "Usage",
      "description": "API key usage and credits."
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/places": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "List places",
        "description": "Returns approved places sorted by name. Costs 1 credit when data is returned.",
        "operationId": "listPlaces",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by a category id, such as `hostel`.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,40}$"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search name, area, and type. Maximum 80 characters.",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (default 20).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip (default 0).",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Places returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/OutOfCredits"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/places/nearby": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Find nearby places",
        "description": "Returns places nearest to the supplied coordinates. Costs 1 credit when data is returned.",
        "operationId": "listNearbyPlaces",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "radius_m",
            "in": "query",
            "description": "Search radius in metres (default 500).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 500
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Optional category id, such as `hostel`.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,40}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (default 20).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nearby places returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyPlaceListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/OutOfCredits"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/places/{id}": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Get a place",
        "description": "Returns one place by id. Costs 1 credit when data is returned.",
        "operationId": "getPlace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Place returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/OutOfCredits"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/places/{id}/images": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Get place images",
        "description": "Returns a place's images in display order. Costs 5 credits when data is returned, including an empty list.",
        "operationId": "getPlaceImages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Place images returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/OutOfCredits"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "List categories",
        "description": "Returns place categories and their place counts. Costs 1 credit when data is returned.",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Categories returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/OutOfCredits"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Get API key usage",
        "description": "Returns the key's plan, remaining credits, reset date, and recent calls. This endpoint is free.",
        "operationId": "getUsage",
        "responses": {
          "200": {
            "description": "Usage returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/KeyRevoked"
          },
          "405": {
            "": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Get an API key from the Maps By FUTA developer dashboard."
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "required": [
          "credits_charged",
          "credits_remaining",
          "rate_limit_remaining"
        ],
        "properties": {
          "credits_charged": {
            "type": "integer",
            "example": 1
          },
          "credits_remaining": {
            "type": "integer",
            "example": 4999
          },
          "rate_limit_remaining": {
            "type": "integer",
            "example": 59
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "example": {
          "credits_charged": 1,
          "credits_remaining": 4999,
          "rate_limit_remaining": 59,
          "pagination": {
            "limit": 20,
            "offset": 0,
            "total": 1,
            "next_offset": null
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "limit",
          "offset",
          "total",
          "next_offset"
        ],
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "next_offset": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "Place": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "type",
          "area",
          "lat",
          "lng",
          "rating",
          "review_count",
          "image_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "0AbCdEf123"
          },
          "name": {
            "type": "string",
            "example": "SUB Cafeteria"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true,
            "example": "food"
          },
          "area": {
            "type": "string",
            "nullable": true,
            "example": "SUB area"
          },
          "lat": {
            "type": "number",
            "example": 7.3001
          },
          "lng": {
            "type": "number",
            "example": 5.1352
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "example": 4.5
          },
          "review_count": {
            "type": "integer",
            "example": 2
          },
          "image_count": {
            "type": "integer",
            "example": 3
          }
        },
        "example": {
          "id": "0AbCdEf123",
          "name": "SUB Cafeteria",
          "description": "Main student cafeteria.",
          "type": "food",
          "area": "SUB area",
          "lat": 7.3001,
          "lng": 5.1352,
          "rating": 4.5,
          "review_count": 2,
          "image_count": 3
        }
      },
      "NearbyPlace": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Place"
          },
          {
            "type": "object",
            "required": [
              "distance_m"
            ],
            "properties": {
              "distance_m": {
                "type": "number",
                "description": "Distance from the requested coordinates in metres."
              }
            }
          }
        ]
      },
      "Image": {
        "type": "object",
        "required": [
          "position",
          "url",
          "full_url"
        ],
        "properties": {
          "position": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "full_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "label",
          "place_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "hostel"
          },
          "label": {
            "type": "string",
            "example": "Hostel"
          },
          "place_count": {
            "type": "integer",
            "example": 107
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "key",
          "plan",
          "credits",
          "resets_at",
          "recent_calls"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Masked API key prefix."
          },
          "plan": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "monthly_credits": {
                "type": "integer"
              },
              "rate_limit_per_minute": {
                "type": "integer"
              }
            }
          },
          "credits": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "integer"
              },
              "topup": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "resets_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "recent_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "credits_charged": {
                  "type": "integer"
                },
                "response_ms": {
                  "type": "integer"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        "example": {
          "key": "fk_live_1a2b…",
          "plan": {
            "id": "starter",
            "name": "Starter",
            "monthly_credits": 5000,
            "rate_limit_per_minute": 60
          },
          "credits": {
            "plan": 4993,
            "topup": 0,
            "total": 4993
          },
          "resets_at": "2026-12-10T07:30:00+00:00",
          "recent_calls": [
            {
              "endpoint": "GET /v1/places",
              "status": 200,
              "credits_charged": 1,
              "response_ms": 84,
              "at": "2026-11-10T07:31:02+00:00"
            }
          ]
        }
      },
      "PlaceListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Place"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "NearbyPlaceListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NearbyPlace"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "PlaceResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Place"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ImageListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Usage"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "nullable": true
              }
            }
          }
        },
        "example": {
          "error": {
            "code": "bad_request",
            "message": "limit must be between 1 and 50."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A parameter is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The API key is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "OutOfCredits": {
        "description": "The key has insufficient credits.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "KeyRevoked": {
        "description": "The API key has been revoked.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested place or endpoint was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The key exceeded its per-minute request limit.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until requests are allowed again.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ServerError": {
        "description": "An unexpected server error occurred. The request is not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Only GET is supported for this endpoint.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
