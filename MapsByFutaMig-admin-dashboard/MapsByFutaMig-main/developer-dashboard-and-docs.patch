+
+// Every error the API can send, with what to do about it.
+export const ERROR_GUIDE = [
+  {
+    status: 400,
+    code: 'bad_request',
+    when: 'A parameter is missing, the wrong type or out of range. The message names it, e.g. "radius_m must be between 1 and 5000."',
