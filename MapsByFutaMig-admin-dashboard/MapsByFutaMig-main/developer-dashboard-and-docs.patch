+}
+.errorText {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.55;
+}
+.errorText b {
+  color: var(--v2-neutral);
+}
+
+/* Endpoints */
+.endpoint {
+  scroll-margin-top: 64px;
+}
+.endpointLine {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 14px;
+  border-radius: 14px;
+  background: var(--v2-hud-upnext-bg);
+}
+.endpointPath {
+  flex: 1;
+  min-width: 0;
+  font-family: var(--font-mono);
+  font-size: 15px;
+  font-weight: 500;
+  color: var(--v2-neutral);
+  overflow-wrap: anywhere;
+}
+.errorsLine {
+  display: flex;
+  gap: 8px;
+  margin: 0;
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: var(--v2-hud-upnext-bg);
+  font-size: 14px;
+  line-height: 1.5;
+}
+.errorsLine svg {
+  flex-shrink: 0;
+  margin-top: 2px;
+  color: var(--v2-primary);
+}
+.errorsLine b {
+  color: var(--v2-neutral);
+}
+
+/* FAQ */
+.faq {
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+  background: var(--v2-on-primary);
+}
+.faqQ {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 14px 16px;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--v2-neutral);
+  cursor: pointer;
+  list-style: none;
+}
+.faqQ::-webkit-details-marker {
+  display: none;
+}
+.faqChevron {
+  flex-shrink: 0;
+  color: var(--v2-text-muted);
+  transition: transform var(--v2-duration-quick) var(--v2-ease-standard);
+}
+.faq[open] .faqChevron {
+  transform: rotate(180deg);
+}
+.faqA {
+  margin: 0;
+  padding: 0 16px 16px;
+  font-size: 14.5px;
+  line-height: 1.6;
+}
+
+.changelog {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.changelog li {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  font-size: 14.5px;
+  line-height: 1.55;
+}
+.changelog b {
+  color: var(--v2-neutral);
+}
+.changeDate {
+  flex-shrink: 0;
+  font-family: var(--v2-font-manrope);
+  font-weight: 700;
+  color: var(--v2-primary);
+}
+.content .endCta {
+  align-self: flex-start;
+  color: var(--v2-on-primary);
+  text-decoration: none;
+}
+.content .endCta:hover {
+  color: var(--v2-on-primary);
+}
+
+/* ── Wider screens ────────────────────────────────────────────────── */
+@media (min-width: 640px) {
+  .paramCards {
+    display: none;
+  }
+  .paramTable {
+    display: block;
+  }
+  .facts {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .errorList {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 1024px) {
+  .hero {
+    padding: 28px 40px 44px;
+  }
+  .title {
+    margin-top: 36px;
+    font-size: 54px;
+  }
+  .lead {
+    font-size: 17px;
+  }
+  .mobileToc {
+    display: none;
+  }
+  .layout {
+    display: grid;
+    grid-template-columns: 230px minmax(0, 1fr);
+    gap: 56px;
+    padding: 12px 40px 80px;
+  }
+  .sidebar {
+    display: block;
+    position: sticky;
+    top: 0;
+    align-self: start;
+    max-height: 100vh;
+    overflow-y: auto;
+    padding: 28px 0;
+  }
+  .section,
+  .h3,
+  .endpoint {
+    scroll-margin-top: 16px;
+  }
+}
diff --git a/src/features/developers/developerApi.js b/src/features/developers/developerApi.js
new file mode 100644
index 0000000..0b1e9a3
--- /dev/null
+++ b/src/features/developers/developerApi.js
@@ -0,0 +1,37 @@
+import { supabase } from '../../lib/supabase';
+import { apiErrorMessage } from './developerData';
+
+// Every call /developers and the admin API tab make. Each one is a
+// security-definer function in supabase/public_api_dashboard.sql that checks
+// who is asking; the api_* tables themselves stay closed to the browser.
+
+async function call(fn, args) {
+  const { data, error } = await supabase.rpc(fn, args);
+  if (error) {
+    const err = new Error(apiErrorMessage(error));
+    err.cause = error;
+    throw err;
+  }
+  return data;
+}
+
+export const fetchPricing = () => call('api_pricing');
+
+// ── The signed-in developer's own keys ───────────────────────────────────
+export const fetchOverview = () => call('api_dev_overview');
+export const createKey = (name) => call('api_dev_create_key', { p_name: name });
+export const rollKey = (keyId) => call('api_dev_roll_key', { p_key_id: keyId });
+export const revokeKey = (keyId) => call('api_dev_revoke_key', { p_key_id: keyId });
+export const fetchKeyUsage = (keyId) => call('api_dev_key_usage', { p_key_id: keyId });
+export const cancelRequest = (id) => call('api_dev_cancel_request', { p_id: id });
+export const requestCredits = ({ keyId, kind, planId = null, credits = null, note = null }) =>
+  call('api_dev_request', { p_key_id: keyId, p_kind: kind, p_plan_id: planId, p_credits: credits, p_note: note });
+
+// ── Admin (each function checks is_admin) ────────────────────────────────
+export const fetchAdminOverview = () => call('api_admin_overview');
+export const adminGrant = (keyId, amount, kind, note) =>
+  call('api_admin_grant', { p_key_id: keyId, p_amount: amount, p_kind: kind, p_note: note || null });
+export const adminSetPlan = (keyId, planId, refill = true) =>
+  call('api_admin_set_plan', { p_key_id: keyId, p_plan_id: planId, p_refill: refill });
+export const adminRevoke = (keyId) => call('api_admin_revoke', { p_key_id: keyId });
+export const adminResolveRequest = (id, status) => call('api_admin_resolve_request', { p_id: id, p_status: status });
