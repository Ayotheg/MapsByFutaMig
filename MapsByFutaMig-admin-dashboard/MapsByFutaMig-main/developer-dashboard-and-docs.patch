+.panel .segmented {
+  background: var(--v2-on-primary);
+}
+.segment {
+  min-height: 34px;
+  padding: 0 14px;
+  border: none;
+  border-radius: var(--r-full);
+  background: none;
+  font-family: var(--font-ui);
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--v2-text);
