+}
+.statusErr {
+  background: var(--v2-error-tint);
+  color: var(--v2-error-text);
+}
+.callPath {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-family: var(--font-mono);
+  font-size: 12px;
+  color: var(--v2-neutral);
+}
+.callCredits {
+  font-family: var(--v2-font-manrope);
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: var(--v2-primary);
+}
+.callTime {
+  color: var(--v2-text-muted);
+  white-space: nowrap;
+}
+
+.segmented {
+  display: flex;
+  gap: 4px;
+  padding: 4px;
