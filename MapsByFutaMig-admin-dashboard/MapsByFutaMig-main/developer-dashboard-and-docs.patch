+@keyframes reveal {
+  from {
+    opacity: 0;
+    transform: translateY(-6px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* ── Key cards ────────────────────────────────────────────────────── */
+.keyList {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+.keyCard {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 16px;
+  border: 1px solid var(--v2-divider);
+  border-radius: 18px;
+  background: var(--v2-on-primary);
+}
+.keyCardRevoked {
+  gap: 8px;
+  background: var(--v2-hud-upnext-bg);
+}
+.keyHead {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.keyIcon {
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 12px;
+  background: var(--v2-primary-tint);
+  color: var(--v2-primary);
+}
+.keyIconMuted {
+  background: var(--v2-divider);
+  color: var(--v2-text-muted);
+}
+.keyTitleBlock {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.keyName {
+  margin: 0;
+  font-family: var(--v2-font-satoshi);
+  font-size: 17px;
+  font-weight: 700;
+  line-height: 1.2;
+  color: var(--v2-neutral);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.keyPrefix {
+  font-family: var(--font-mono);
+  font-size: 12.5px;
+  color: var(--v2-text-muted);
+}
+.keyFootnote {
+  margin: 0;
+  font-size: 12.5px;
+  color: var(--v2-text-muted);
+}
+
+.pill {
+  flex-shrink: 0;
+  padding: 4px 10px;
+  border-radius: var(--r-full);
+  font-size: 12px;
+  font-weight: 700;
+  white-space: nowrap;
+}
+.pillViolet {
+  background: var(--v2-primary-tint);
+  color: var(--v2-primary-hover);
+}
+.pillTeal {
+  background: var(--v2-secondary-tint);
+  color: var(--v2-neutral);
+}
+.pillMuted {
+  background: var(--v2-divider);
+  color: var(--v2-text);
+}
+
+.credits {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 14px;
+  border-radius: 14px;
+  background: var(--v2-hud-upnext-bg);
+}
+.creditsTop {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+.creditsValue {
+  font-family: var(--v2-font-manrope);
+  font-size: 32px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+  letter-spacing: -0.02em;
+  color: var(--v2-primary);
+}
+.creditsValueWarn {
+  color: var(--v2-error-text);
+}
+.creditsLabel {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--v2-text);
+}
+.meter {
+  height: 8px;
+  border-radius: var(--r-full);
+  background: var(--v2-divider);
+  overflow: hidden;
+}
+.meterFill {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: linear-gradient(90deg, var(--v2-primary), var(--v2-secondary));
+  transition: width var(--v2-duration-standard) var(--v2-ease-standard);
+}
+.meterFillWarn {
+  background: var(--v2-error-text);
+}
+.creditsRows {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  font-size: 12.5px;
+  color: var(--v2-text);
+}
+.creditsRows b {
+  font-family: var(--v2-font-manrope);
+  font-variant-numeric: tabular-nums;
+  font-weight: 700;
+  color: var(--v2-neutral);
+}
+
+.keyStats {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 8px;
+  margin: 0;
+}
+.keyStats div {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+.keyStats dt {
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--v2-text-muted);
+}
+.keyStats dd {
+  margin: 0;
+  font-size: 13.5px;
+  font-weight: 600;
+  color: var(--v2-neutral);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.requestList {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.requestItem {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 10px;
+  border-radius: 12px;
+  background: var(--v2-primary-tint);
+  font-size: 13px;
+  color: var(--v2-neutral);
+}
+.requestDot {
+  flex-shrink: 0;
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--v2-primary);
+}
+.requestText {
+  flex: 1;
+  min-width: 0;
+}
+
+.keyActions {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 6px;
+}
+.actionBtn {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  min-height: 56px;
+  padding: 6px 4px;
+  border: 1px solid var(--v2-divider);
+  border-radius: 12px;
+  background: var(--v2-on-primary);
+  font-family: var(--font-ui);
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--v2-neutral);
+  cursor: pointer;
+  transition: background var(--v2-duration-quick) var(--v2-ease-standard),
+    border-color var(--v2-duration-quick) var(--v2-ease-standard);
+}
+.actionBtn svg {
+  color: var(--v2-primary);
+}
+.actionBtn:hover {
+  background: var(--v2-hud-upnext-bg);
+}
+.actionBtnOpen {
+  border-color: var(--v2-primary);
+  background: var(--v2-primary-tint);
+}
+.actionBtnDanger svg {
+  color: var(--v2-error-text);
+}
+.actionBtnDanger.actionBtnOpen {
+  border-color: var(--v2-error-text);
+  background: var(--v2-error-tint);
+}
+
+/* ── Panels under a key ───────────────────────────────────────────── */
+.panel {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 14px;
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+  background: var(--v2-hud-upnext-bg);
+  animation: reveal var(--v2-duration-standard) var(--v2-ease-standard);
+}
+.panelDanger {
+  border-color: var(--v2-error-text);
+  background: var(--v2-error-tint);
+}
+.panelHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+.panelTitle {
+  margin: 0;
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--v2-neutral);
+}
+.panelClose {
+  display: grid;
+  place-items: center;
+  width: 28px;
+  height: 28px;
+  border: none;
+  border-radius: 50%;
+  background: var(--v2-on-primary);
+  color: var(--v2-text);
+  cursor: pointer;
+}
+.panelBody {
+  margin: 0;
+  font-size: 13.5px;
+  line-height: 1.5;
+}
+
+.chart {
+  display: grid;
+  grid-template-columns: repeat(14, minmax(0, 1fr));
+  align-items: end;
+  gap: 4px;
+  height: 96px;
+}
+.chartCol {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 4px;
+  height: 100%;
+  min-width: 0;
+}
+.chartBar {
+  width: 100%;
+  max-width: 18px;
+  border-radius: 4px 4px 2px 2px;
+  background: var(--v2-primary);
+}
+.chartDay {
+  font-size: 10px;
+  color: var(--v2-text-muted);
+}
+
+.callList {
+  display: flex;
+  flex-direction: column;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  border-radius: 12px;
+  background: var(--v2-on-primary);
+  overflow: hidden;
+}
+.callRow {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto auto;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 10px;
