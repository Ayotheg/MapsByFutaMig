index 0000000..356a8eb
--- /dev/null
+++ b/scripts/developerData.test.mjs
@@ -0,0 +1,128 @@
+// Tests for src/features/developers/developerData.js: the pure rules behind
+// /developers and the admin API tab (formatting, credit meter, new-key
+// limits, usage chart, error sentences, code samples).
+// Run: node scripts/developerData.test.mjs
+import assert from 'node:assert/strict';
+import {
+  API_BASE_URL,
+  ENDPOINTS,
+  FALLBACK_PRICING,
+  apiErrorMessage,
+  costFor,
+  creditSummary,
+  dayInitial,
+  formatNaira,
+  formatNumber,
+  maskedPrefix,
+  newKeyState,
+  requestLabel,
+  sampleCurl,
+  sampleJs,
+  shortDay,
+  timeAgo,
+  usageBars,
+  validateKeyName,
+} from '../src/features/developers/developerData.js';
+
+// ── formatting
+assert.equal(formatNumber(25000), '25,000');
+assert.equal(formatNumber('1200'), '1,200');
+assert.equal(formatNumber(null), '0');
+assert.equal(formatNaira(3000), '₦3,000');
+assert.equal(formatNaira(0), 'Free');
+assert.equal(maskedPrefix('fk_live_2e02'), 'fk_live_2e02••••');
+
+const now = new Date('2026-11-10T12:00:00Z');
+assert.equal(shortDay('2026-12-10T06:00:00Z', now), '10 Dec');
+assert.equal(shortDay('2027-01-03T06:00:00Z', now), '3 Jan 2027');
+// Lagos is UTC+1: 23:30 UTC on the 9th is already the 10th there.
+assert.equal(shortDay('2026-11-09T23:30:00Z', now), '10 Nov');
+assert.equal(shortDay('nonsense', now), '');
+assert.equal(timeAgo(null, now), 'never');
+assert.equal(timeAgo('2026-11-10T11:59:40Z', now), 'just now');
+assert.equal(timeAgo('2026-11-10T11:55:00Z', now), '5 min ago');
+assert.equal(timeAgo('2026-11-10T09:00:00Z', now), '3 h ago');
+assert.equal(timeAgo('2026-11-09T09:00:00Z', now), 'yesterday');
+assert.equal(timeAgo('2026-11-06T09:00:00Z', now), '4 days ago');
+assert.equal(timeAgo('2026-10-01T09:00:00Z', now), '1 Oct');
+assert.equal(timeAgo('2026-11-10T12:00:30Z', now), 'just now', 'clock skew never goes negative');
+assert.equal(dayInitial('2026-11-09'), 'M');
+console.log('ok: developer formatting');
+
+// ── credit meter
+assert.deepEqual(creditSummary({ plan_credits: 750, topup_credits: 200, monthly_credits: 1000 }), {
+  plan: 750, topup: 200, monthly: 1000, total: 950, planShare: 0.75, tone: 'ok',
+});
+assert.equal(creditSummary({ plan_credits: 50, topup_credits: 0, monthly_credits: 1000 }).tone, 'low');
+assert.equal(creditSummary({ plan_credits: 0, topup_credits: 0, monthly_credits: 1000 }).tone, 'empty');
+assert.equal(creditSummary({ plan_credits: 0, topup_credits: 5000, monthly_credits: 1000 }).tone, 'ok', 'top-ups count');
+assert.equal(creditSummary({ plan_credits: 6000, monthly_credits: 5000 }).planShare, 1, 'never over 100%');
+assert.equal(creditSummary({ plan_credits: '980', monthly_credits: '1000' }).total, 980, 'numeric strings');
+assert.deepEqual(creditSummary(null), { plan: 0, topup: 0, monthly: 0, total: 0, planShare: 0, tone: 'empty' });
+console.log('ok: credit meter');
+
+// ── new-key rules mirror the database (one active Free key, five in all)
+const key = (plan_id, status = 'active') => ({ plan_id, status });
+assert.deepEqual(newKeyState([]), { allowed: true, reason: null });
+assert.equal(newKeyState([key('free')]).allowed, false);
+assert.match(newKeyState([key('free')]).reason, /one Free key/);
+assert.equal(newKeyState([key('free', 'revoked')]).allowed, true, 'a revoked Free key frees the slot');
+assert.equal(newKeyState([key('starter')]).allowed, true, 'after an upgrade, a new Free key is allowed');
+assert.equal(newKeyState(Array.from({ length: 5 }, () => key('starter'))).allowed, false);
+assert.match(newKeyState(Array.from({ length: 5 }, () => key('starter'))).reason, /5 active keys/);
+assert.equal(validateKeyName(' '), 'Give the key a name, like the app it is for.');
+assert.equal(validateKeyName('ab'), null);
+assert.match(validateKeyName('x'.repeat(61)), /under 60/);
+console.log('ok: new-key rules');
+
+// ── usage chart: by credits, by calls when nothing was charged
+const daily = [
+  { day: '2026-11-08', calls: 4, credits: 0 },
+  { day: '2026-11-09', calls: 10, credits: 10 },
+  { day: '2026-11-10', calls: 2, credits: 5 },
+];
+assert.deepEqual(usageBars(daily).map((b) => b.height), [0, 1, 0.5]);
+assert.deepEqual(usageBars(daily.map((d) => ({ ...d, credits: 0 }))).map((b) => b.height), [0.4, 1, 0.2]);
+assert.deepEqual(usageBars([{ day: 'x', calls: 0, credits: 0 }]).map((b) => b.height), [0]);
+assert.deepEqual(usageBars(null), []);
+console.log('ok: usage chart');
+
+// ── requests and prices
+const plans = FALLBACK_PRICING.plans;
+assert.equal(requestLabel({ kind: 'upgrade', plan_id: 'growth' }, plans), 'Upgrade to Growth');
+assert.equal(requestLabel({ kind: 'upgrade', plan_id: 'gone' }, plans), 'Upgrade to gone');
+assert.equal(requestLabel({ kind: 'topup', credits: 5000 }, plans), '5,000 more credits');
+assert.equal(costFor(FALLBACK_PRICING.costs, 'GET /v1/places/:id/images'), 5);
+assert.equal(costFor(FALLBACK_PRICING.costs, 'GET /v1/usage'), 0);
+assert.equal(costFor([], 'GET /v1/places'), null);
+// Every documented endpoint has a price, and the fallback matches the SQL seeds.
+for (const ep of ENDPOINTS) assert.notEqual(costFor(FALLBACK_PRICING.costs, ep.pattern), null, ep.pattern);
+assert.deepEqual(plans.map((p) => [p.id, p.price_ngn, p.monthly_credits, p.rate_limit]), [
+  ['free', 0, 1000, 20],
+  ['starter', 3000, 5000, 60],
+  ['growth', 10000, 25000, 120],
+]);
+console.log('ok: requests and prices');
+
+// ── code samples use the public address and never a real key
+assert.equal(API_BASE_URL, 'https://mapsbyfuta.xyz/api/v1');
+assert.match(sampleCurl(), /^curl "https:\/\/mapsbyfuta\.xyz\/api\/v1\/places\?type=hostel&limit=5" \\\n {2}-H "x-api-key: YOUR_API_KEY"$/);
+assert.ok(sampleJs().includes('process.env.MAPS_BY_FUTA_KEY'));
+assert.ok(!/supabase/i.test(sampleCurl() + sampleJs()), 'developers never see the Supabase address');
+console.log('ok: code samples');
+
+// ── database errors become sentences, never raw Postgres text
+const err = (message, code) => ({ message, code });
+assert.match(apiErrorMessage(err('free_key_exists')), /one Free key/);
+assert.match(apiErrorMessage(err('key_limit')), /5 active keys/);
+assert.match(apiErrorMessage(err('not_signed_in')), /Sign in again/);
+assert.match(apiErrorMessage(err('not_admin')), /Admins only/);
+assert.match(apiErrorMessage(err('request_open')), /already asked/);
+assert.match(apiErrorMessage(err('Could not find the function public.api_dev_overview', 'PGRST202')), /public_api_dashboard\.sql/);
+assert.match(apiErrorMessage(err('amount must be greater than 0')), /above 0/);
+assert.match(apiErrorMessage(err('TypeError: Failed to fetch')), /connection/);
+assert.equal(apiErrorMessage(err('relation "api_keys" does not exist at character 15')), 'Something went wrong. Try again.');
+// "key_revoked" inside a longer word must not match a different code.
+assert.match(apiErrorMessage(err('key_revoked')), /revoked/);
+assert.equal(apiErrorMessage(null), null);
+console.log('ok: error sentences');
diff --git a/scripts/docsSamples.test.mjs b/scripts/docsSamples.test.mjs
new file mode 100644
index 0000000..4e34c6e
--- /dev/null
+++ b/scripts/docsSamples.test.mjs
@@ -0,0 +1,133 @@
+// Keeps /developers/docs honest: every example in
+// src/features/developers/docsSamples.js is checked against the Public API's
+// real rules and output shaping (supabase/functions/_shared/publicApi.ts).
+// If the API changes, this fails until the docs are updated.
+// Run: node scripts/docsSamples.test.mjs
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import {
+  ENDPOINT_SAMPLES,
+  ERROR_GUIDE,
+  EXAMPLE_ERROR,
+  EXAMPLE_PLACE,
+  RECIPES,
+  json,
+} from '../src/features/developers/docsSamples.js';
+import { API_BASE_URL } from '../src/features/developers/developerData.js';
+
+// publicApi.ts has no TypeScript-only syntax: import it as plain JS.
+const dir = mkdtempSync(join(tmpdir(), 'docs-samples-'));
+const copy = join(dir, 'publicApi.mjs');
+writeFileSync(copy, readFileSync(new URL('../supabase/functions/_shared/publicApi.ts', import.meta.url), 'utf8'));
+const api = await import(pathToFileURL(copy).href);
+rmSync(dir, { recursive: true, force: true });
+const handlerSrc = readFileSync(new URL('../supabase/functions/public-api/handler.ts', import.meta.url), 'utf8');
+
+const PROXY = { imageProxyUrl: 'https://ik.imagekit.io/pk5x5zal3', supabaseUrl: 'https://example.supabase.co' };
+const strip = (p) => Object.fromEntries(Object.entries(p).filter(([k]) => k !== 'distance_m'));
+
+// ── every documented endpoint has samples in all three languages, and the
+//    request in each one is valid for the real API
+const patterns = Object.keys(api.DEFAULT_COSTS);
+assert.deepEqual(Object.keys(ENDPOINT_SAMPLES).sort(), patterns.sort(), 'docs cover exactly the real endpoints');
+for (const [pattern, s] of Object.entries(ENDPOINT_SAMPLES)) {
+  for (const lang of ['curl', 'js', 'python']) {
+    assert.ok(s[lang].includes(API_BASE_URL), `${pattern} ${lang}: public base URL`);
+    assert.ok(!/supabase/i.test(s[lang]), `${pattern} ${lang}: never the Supabase address`);
+    assert.ok(/x-api-key/.test(s[lang]), `${pattern} ${lang}: sends the key header`);
+    assert.ok(!/fk_live_[0-9a-f]{48}/.test(s[lang]), `${pattern} ${lang}: no real-looking key`);
+  }
+  const url = new URL(s.curl.match(/"(https:[^"]+)"/)[1]);
+  const route = api.matchRoute(url.pathname.replace(/^\/api/, ''));
+  assert.equal(route?.pattern, pattern, `${pattern}: curl hits the right route`);
+  if (route.name === 'places.list') assert.ok(!api.parseListParams(url.searchParams).error, 'list params valid');
+  if (route.name === 'places.nearby') assert.ok(!api.parseNearbyParams(url.searchParams).error, 'nearby params valid');
+  if (route.id) assert.ok(api.isPlaceId(route.id), `${pattern}: example id is a valid id`);
+}
+console.log('ok: docs samples hit real routes with valid parameters');
+
+// ── example responses have exactly the fields the API sends
+const meta = (m) => Object.keys(m).filter((k) => k !== 'pagination');
+for (const [pattern, s] of Object.entries(ENDPOINT_SAMPLES)) {
+  const { data, meta: m } = s.response;
+  assert.deepEqual(meta(m), Object.keys(api.envelope(null).meta), `${pattern}: meta fields`);
+  assert.equal(m.credits_charged, api.costFor(pattern, null), `${pattern}: credits_charged matches the default price`);
+}
+const places = [
+  ...ENDPOINT_SAMPLES['GET /v1/places'].response.data,
+  ENDPOINT_SAMPLES['GET /v1/places/:id'].response.data,
+];
+for (const p of places) assert.deepEqual(api.toPlace(p), p, `place ${p.name} is exactly what toPlace returns`);
+for (const p of ENDPOINT_SAMPLES['GET /v1/places/nearby'].response.data) {
+  assert.deepEqual(api.toPlace(p), p, `nearby ${p.name} shape`);
+}
+assert.deepEqual(api.toPlace(EXAMPLE_PLACE), EXAMPLE_PLACE);
+for (const c of ENDPOINT_SAMPLES['GET /v1/categories'].response.data) {
+  assert.deepEqual(api.toCategory({ type: c.id, place_count: c.place_count }), c, `category ${c.id}`);
+}
+for (const img of ENDPOINT_SAMPLES['GET /v1/places/:id/images'].response.data) {
+  const path = new URL(img.url).pathname.replace(/^\/pk5x5zal3\//, '');
+  assert.deepEqual(api.toImage({ storage_path: path, position: img.position }, PROXY), img, 'image URLs as the API builds them');
+}
+const usage = ENDPOINT_SAMPLES['GET /v1/usage'].response.data;
+assert.deepEqual(Object.keys(usage), ['key', 'plan', 'credits', 'resets_at', 'recent_calls']);
+for (const k of ['key:', 'plan:', 'credits:', 'resets_at:', 'recent_calls:', 'rate_limit_per_minute:', 'monthly_credits:', 'topup:', 'total:']) {
+  assert.ok(handlerSrc.includes(k), `usage field ${k} exists in handler.ts`);
+}
+for (const call of usage.recent_calls) {
+  assert.deepEqual(Object.keys(call), Object.keys(api.toUsageCall({})), 'recent call fields');
+}
+assert.equal(usage.credits.total, usage.credits.plan + usage.credits.topup);
+assert.equal(usage.key.length, 12, 'only the 12-character prefix');
+console.log('ok: docs responses match the real output shaping');
+
+// ── the numbers in the examples add up
+const list = ENDPOINT_SAMPLES['GET /v1/places'].response;
+const pg = list.meta.pagination;
+assert.equal(pg.limit, list.data.length);
+assert.equal(pg.next_offset, pg.offset + list.data.length < pg.total ? pg.offset + list.data.length : null);
+assert.deepEqual(list.data.map((p) => p.name), [...list.data.map((p) => p.name)].sort(), 'sorted by name');
+// distance_m is the haversine distance from the example point, rounded.
+const hav = (a, b, c, d) => {
+  const r = (x) => (x * Math.PI) / 180;
+  const h = Math.sin(r(c - a) / 2) ** 2 + Math.cos(r(a)) * Math.cos(r(c)) * Math.sin(r(d - b) / 2) ** 2;
+  return 2 * 6371000 * Math.asin(Math.min(1, Math.sqrt(h)));
+};
+const near = ENDPOINT_SAMPLES['GET /v1/places/nearby'];
+const q = new URL(near.curl.match(/"(https:[^"]+)"/)[1]).searchParams;
+let last = -1;
+for (const p of near.response.data) {
+  const d = Math.round(hav(Number(q.get('lat')), Number(q.get('lng')), p.lat, p.lng));
+  assert.equal(p.distance_m, d, `${p.name} distance`);
+  assert.ok(d <= Number(q.get('radius_m')), 'inside the radius');
+  assert.ok(d >= last, 'nearest first');
+  last = d;
+}
+console.log('ok: docs example numbers are consistent');
+
+// ── errors: every code the API can send is documented, with the right status
+const documented = Object.fromEntries(ERROR_GUIDE.map((e) => [e.code, e.status]));
+const real = Object.fromEntries(Object.entries(api.ERRORS).map(([code, [status]]) => [code, status]));
+assert.deepEqual(documented, real);
+// The example error is word-for-word what the API says for limit=500.
+const bad = api.parseListParams(new URLSearchParams('limit=500'));
+assert.deepEqual(api.errorBody('bad_request', bad.error).body, EXAMPLE_ERROR);
+console.log('ok: docs errors match the API');
+
+// ── recipes use the public address, the env var, and real fields
+for (const [name, code] of Object.entries(RECIPES)) {
+  assert.ok(!/supabase/i.test(code), `${name}: no Supabase address`);
+  assert.ok(!/fk_live_[0-9a-f]{48}/.test(code), `${name}: no real-looking key`);
+}
+for (const name of ['paginate', 'paginatePython', 'retry', 'proxyExpress', 'proxyNext']) {
+  assert.ok(RECIPES[name].includes(API_BASE_URL), `${name}: public base URL`);
+  assert.ok(RECIPES[name].includes('MAPS_BY_FUTA_KEY'), `${name}: key from the environment`);
+}
+assert.ok(RECIPES.paginate.includes('next_offset') && RECIPES.paginatePython.includes('next_offset'));
+assert.ok(RECIPES.retry.includes('retry-after') && RECIPES.retry.includes('>= 500'));
+assert.match(RECIPES.firstCall, /\/usage"/, 'first call is the free endpoint');
+assert.equal(json({ a: 1 }), '{\n  "a": 1\n}');
+console.log('ok: docs recipes');
