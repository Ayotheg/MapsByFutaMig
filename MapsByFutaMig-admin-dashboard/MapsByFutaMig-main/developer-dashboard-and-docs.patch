+}
+.segment:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+.segmentActive {
+  background: var(--v2-primary);
+  color: var(--v2-on-primary);
+}
+
+.choiceList {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.choice {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  grid-template-areas: 'name price' 'meta price';
+  align-items: center;
+  gap: 2px 10px;
+  padding: 12px 14px;
+  border: 1.5px solid var(--v2-divider);
+  border-radius: 14px;
+  background: var(--v2-on-primary);
