+  border-radius: var(--r-full);
+  background: var(--v2-on-primary);
+  font-family: var(--v2-font-manrope);
+  font-size: 14px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: var(--v2-neutral);
+  cursor: pointer;
+}
+.chipActive {
+  border-color: var(--v2-primary);
