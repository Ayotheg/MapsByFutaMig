+    'res = requests.get(',
+    `    "${API_BASE_URL}${path}",`,
+    ...(params ? [`    params=${params},`] : []),
+    '    headers={"x-api-key": os.environ["MAPS_BY_FUTA_KEY"]},',
+    '    timeout=10,',
+    ')',
+    'body = res.json()',
+    'if not res.ok:',
+    '    raise RuntimeError(f"{body[\'error\'][\'code\']}: {body[\'error\'][\'message\']}")',
+    after,
+  ].join('\n');
+
+export const ENDPOINT_SAMPLES = {
