+/* /developers/docs (DocsPage.jsx). A reading page: short violet hero, then
+   a sticky contents list beside the text at 1024px+, or an "On this page"
+   menu on phones. Code blocks, segmented tabs and pills come from
+   DevelopersPage.module.css so both pages match. Brand tokens only. */
+
+.page {
+  min-height: 100vh;
+  min-height: 100dvh;
+  background: var(--v2-on-primary);
+  font-family: var(--font-ui);
+  color: var(--v2-text);
+}
+
+.num {
+  font-family: var(--v2-font-manrope);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+/* ── Hero ─────────────────────────────────────────────────────────── */
+.hero {
+  position: relative;
+  overflow: hidden;
+  padding: calc(16px + var(--mob-safe-top, 0px)) 20px 32px;
+  background: linear-gradient(135deg, var(--v2-primary) 0%, var(--v2-primary-hover) 100%);
+  color: var(--v2-on-primary);
+}
+.heroCircle {
+  position: absolute;
+  top: -160px;
+  right: -140px;
+  width: 380px;
+  height: 380px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.07);
+}
+.heroInner {
+  position: relative;
+  max-width: 1120px;
+  margin: 0 auto;
+}
+.topBar {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.title {
+  margin: 20px 0 10px;
+  font-family: var(--v2-font-satoshi);
+  font-size: clamp(34px, 10vw, 48px);
+  font-weight: 900;
+  line-height: 1.05;
+  letter-spacing: -0.03em;
+  color: var(--v2-on-primary);
+}
+.lead {
+  max-width: 38rem;
+  margin: 0 0 18px;
+  font-size: 15px;
+  line-height: 1.55;
+  color: var(--v2-on-primary);
+  opacity: 0.92;
+}
+.heroActions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+.heroBtn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 42px;
+  padding: 0 16px;
+  border-radius: var(--r-full);
+  background: var(--v2-on-primary);
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--v2-primary);
+  text-decoration: none;
+  transition: background var(--v2-duration-quick) var(--v2-ease-standard);
+}
+.heroBtn:hover {
+  background: var(--v2-primary-tint);
+}
+.heroBtnGhost {
+  background: rgba(255, 255, 255, 0.16);
+  color: var(--v2-on-primary);
+}
+.heroBtnGhost:hover {
+  background: rgba(255, 255, 255, 0.26);
+}
+
+/* ── Contents ─────────────────────────────────────────────────────── */
+.mobileToc {
+  position: sticky;
+  top: 0;
+  z-index: 5;
+  border-bottom: 1px solid var(--v2-divider);
+  background: var(--v2-on-primary);
+}
+.mobileTocBtn {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  min-height: 48px;
+  padding: 0 20px;
+  border: none;
+  background: none;
+  font-family: var(--font-ui);
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--v2-neutral);
+  cursor: pointer;
+}
+.mobileTocPanel {
+  max-height: 60vh;
+  overflow-y: auto;
+  padding: 0 12px 12px;
+}
+.sidebar {
+  display: none;
+}
+.tocList,
+.tocChildren {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.tocChildren {
+  margin: 2px 0 4px 10px;
+  padding-left: 8px;
+  border-left: 1px solid var(--v2-divider);
+}
+.tocLink {
+  display: block;
+  padding: 6px 10px;
+  border-radius: 8px;
+  font-size: 14px;
+  color: var(--v2-text);
+  text-decoration: none;
+}
+.tocChild {
+  font-size: 13px;
+}
+.tocLink:hover {
+  background: var(--v2-hud-upnext-bg);
+  color: var(--v2-neutral);
+}
+.tocLinkActive,
+.tocLinkActive:hover {
+  background: var(--v2-primary-tint);
+  font-weight: 600;
+  color: var(--v2-primary-hover);
+}
+
+/* ── Content ──────────────────────────────────────────────────────── */
+.layout {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 8px 20px 64px;
+}
+.content {
+  min-width: 0;
+  max-width: 780px;
+}
+.section {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 28px 0;
+  border-bottom: 1px solid var(--v2-divider);
+  /* Leaves room for the sticky "On this page" bar when jumping here. */
+  scroll-margin-top: 64px;
+}
+.content a {
+  color: var(--v2-primary);
+  font-weight: 500;
+}
+.content a:hover {
+  color: var(--v2-primary-hover);
+}
+.h2 {
+  margin: 0;
+  font-family: var(--v2-font-satoshi);
+  font-size: 26px;
+  font-weight: 700;
+  line-height: 1.2;
+  letter-spacing: -0.015em;
+  color: var(--v2-neutral);
+}
+.content .anchor {
+  color: inherit;
+  font-weight: inherit;
+  text-decoration: none;
+}
+.content .anchor:hover::after {
+  content: ' #';
+  color: var(--v2-primary-outline);
+}
+.h3 {
+  margin: 10px 0 0;
+  font-family: var(--v2-font-satoshi);
+  font-size: 18px;
+  font-weight: 700;
+  color: var(--v2-neutral);
+  scroll-margin-top: 64px;
+}
+.p {
+  margin: 0;
+  font-size: 15px;
+  line-height: 1.65;
+}
+.p b,
+.list b {
+  color: var(--v2-neutral);
+  font-weight: 600;
+}
+.list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  margin: 0;
+  padding-left: 20px;
+  font-size: 15px;
+  line-height: 1.6;
+}
+.list li::marker {
+  color: var(--v2-primary);
+}
+
+.facts {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1px;
+  margin: 0;
+  overflow: hidden;
+  border: 1px solid var(--v2-divider);
+  border-radius: 16px;
+  background: var(--v2-divider);
+}
+.fact {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 12px 14px;
+  background: var(--v2-on-primary);
+}
+.fact dt {
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--v2-primary);
+}
+.fact dd {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.5;
+  color: var(--v2-neutral);
+  overflow-wrap: anywhere;
+}
+
+/* Get started */
+.steps {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.step {
+  display: flex;
+  gap: 14px;
+}
+.stepNum {
+  flex-shrink: 0;
+  display: grid;
+  place-items: center;
+  width: 32px;
+  height: 32px;
+  border-radius: 10px;
+  background: var(--v2-primary-tint);
+  font-family: var(--v2-font-manrope);
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--v2-primary);
+}
+.stepBody {
+  flex: 1;
+  min-width: 0;
+}
+.stepTitle {
+  margin: 4px 0 6px;
+  font-family: var(--v2-font-satoshi);
+  font-size: 17px;
+  font-weight: 700;
+  color: var(--v2-neutral);
+}
+.stepText {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  font-size: 15px;
+  line-height: 1.6;
+}
+.stepText b {
+  color: var(--v2-neutral);
+}
+
+.callout {
+  display: flex;
+  gap: 12px;
+  padding: 14px 16px;
+  border: 1px solid var(--v2-primary-outline);
+  border-radius: 14px;
+  background: var(--v2-primary-tint);
+}
+.calloutWarn {
+  border-color: var(--v2-error-text);
+  background: var(--v2-error-tint);
+}
+.calloutIcon {
+  flex-shrink: 0;
+  margin-top: 1px;
+  color: var(--v2-primary);
+}
+.calloutWarn .calloutIcon {
+  color: var(--v2-error-text);
+}
+.calloutTitle {
+  margin: 0 0 4px;
+  font-size: 15px;
+  font-weight: 700;
+  color: var(--v2-neutral);
+}
+.calloutText {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.55;
+}
+
+/* Tables scroll sideways on phones instead of squashing. */
+.tableWrap {
+  overflow-x: auto;
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+}
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 14px;
+  line-height: 1.5;
+}
+.table th {
+  padding: 10px 12px;
+  background: var(--v2-hud-upnext-bg);
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-align: left;
+  text-transform: uppercase;
+  color: var(--v2-text-muted);
+  white-space: nowrap;
+}
+.table td {
+  padding: 10px 12px;
+  border-top: 1px solid var(--v2-divider);
+  vertical-align: top;
+  color: var(--v2-text);
+}
+.table td:first-child {
+  white-space: nowrap;
+}
+.table td b {
+  color: var(--v2-neutral);
+}
+.typeCell {
+  font-size: 13px;
+  color: var(--v2-text-muted);
+  white-space: nowrap;
+}
+
+/* Parameters: cards on phones, the table from 640px. */
+.paramCards {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.paramCard {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 12px 14px;
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+}
+.paramTop {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px 8px;
+}
+.paramTag {
+  padding: 2px 8px;
+  border-radius: var(--r-full);
+  background: var(--v2-hud-upnext-bg);
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--v2-text);
+}
+.paramTagReq {
+  background: var(--v2-primary-tint);
+  color: var(--v2-primary-hover);
+}
+.paramRules {
+  font-size: 14px;
+  line-height: 1.55;
+}
+.paramTable {
+  display: none;
+}
+
+/* Field tables on phones: name and type on one line, the description
+   under them at full width, instead of three thin columns. */
+@media (max-width: 639px) {
+  .fieldTable thead {
+    display: none;
+  }
+  .fieldTable tr {
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr);
+    align-items: baseline;
+    gap: 4px 10px;
+    padding: 10px 12px;
+  }
+  .fieldTable tr + tr {
+    border-top: 1px solid var(--v2-divider);
+  }
+  .fieldTable td {
+    padding: 0;
+    border-top: none;
+  }
+  .fieldTable td:nth-child(3) {
+    grid-column: 1 / -1;
+  }
+}
+
+/* Errors */
+.errorList {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 10px;
+}
+.errorItem {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 14px;
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+}
+.errorHead {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.statusPill {
+  padding: 2px 8px;
+  border-radius: 6px;
+  background: var(--v2-primary-tint);
+  font-family: var(--v2-font-manrope);
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--v2-primary-hover);
+}
+.status429 {
+  background: var(--v2-hud-upnext-bg);
+  color: var(--v2-neutral);
+}
+.status5 {
+  background: var(--v2-error-tint);
+  color: var(--v2-error-text);
+}
+.errorText {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.55;
+}
+.errorText b {
+  color: var(--v2-neutral);
+}
+
+/* Endpoints */
+.endpoint {
+  scroll-margin-top: 64px;
+}
+.endpointLine {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 14px;
+  border-radius: 14px;
+  background: var(--v2-hud-upnext-bg);
+}
+.endpointPath {
+  flex: 1;
+  min-width: 0;
+  font-family: var(--font-mono);
+  font-size: 15px;
+  font-weight: 500;
+  color: var(--v2-neutral);
+  overflow-wrap: anywhere;
+}
+.errorsLine {
+  display: flex;
+  gap: 8px;
+  margin: 0;
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: var(--v2-hud-upnext-bg);
+  font-size: 14px;
+  line-height: 1.5;
+}
+.errorsLine svg {
+  flex-shrink: 0;
+  margin-top: 2px;
+  color: var(--v2-primary);
+}
+.errorsLine b {
+  color: var(--v2-neutral);
+}
+
+/* FAQ */
+.faq {
+  border: 1px solid var(--v2-divider);
+  border-radius: 14px;
+  background: var(--v2-on-primary);
+}
+.faqQ {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 14px 16px;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--v2-neutral);
+  cursor: pointer;
+  list-style: none;
+}
+.faqQ::-webkit-details-marker {
+  display: none;
+}
+.faqChevron {
+  flex-shrink: 0;
+  color: var(--v2-text-muted);
+  transition: transform var(--v2-duration-quick) var(--v2-ease-standard);
+}
+.faq[open] .faqChevron {
+  transform: rotate(180deg);
+}
+.faqA {
+  margin: 0;
+  padding: 0 16px 16px;
+  font-size: 14.5px;
+  line-height: 1.6;
+}
+
+.changelog {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.changelog li {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  font-size: 14.5px;
+  line-height: 1.55;
+}
+.changelog b {
+  color: var(--v2-neutral);
+}
+.changeDate {
+  flex-shrink: 0;
+  font-family: var(--v2-font-manrope);
+  font-weight: 700;
+  color: var(--v2-primary);
+}
+.content .endCta {
+  align-self: flex-start;
+  color: var(--v2-on-primary);
+  text-decoration: none;
+}
+.content .endCta:hover {
+  color: var(--v2-on-primary);
+}
+
+/* ── Wider screens ────────────────────────────────────────────────── */
+@media (min-width: 640px) {
+  .paramCards {
+    display: none;
+  }
+  .paramTable {
+    display: block;
+  }
+  .facts {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .errorList {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 1024px) {
+  .hero {
+    padding: 28px 40px 44px;
+  }
+  .title {
+    margin-top: 36px;
+    font-size: 54px;
+  }
+  .lead {
+    font-size: 17px;
+  }
+  .mobileToc {
+    display: none;
+  }
+  .layout {
+    display: grid;
+    grid-template-columns: 230px minmax(0, 1fr);
+    gap: 56px;
+    padding: 12px 40px 80px;
+  }
+  .sidebar {
+    display: block;
+    position: sticky;
+    top: 0;
+    align-self: start;
+    max-height: 100vh;
+    overflow-y: auto;
+    padding: 28px 0;
+  }
+  .section,
+  .h3,
+  .endpoint {
+    scroll-margin-top: 16px;
+  }
+}
